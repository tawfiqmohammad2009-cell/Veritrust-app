<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Header / App Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Veritrust Shield"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="16dp"
        android:background="#1F1F1F" />

    <!-- Container for Sections (Swapped dynamically) -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Navigation Bar for the 3 Sections -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#1F1F1F"
        android:gravity="center">

        <Button
            android:id="@+id/nav_dialer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📞 Dialer"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/nav_lookup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🔍 Check"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/nav_shield"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🛡️ AI Shield"
            android:background="?android:attr/selectableItemBackground"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>
